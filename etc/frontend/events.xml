<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
    <event name="sales_quote_save_before">
        <observer name="softaware_ga4_cart_changes" instance="Softaware\Ga4\Observer\QueueCartChanges"/>
    </event>
    <event name="sales_quote_merge_before">
        <observer name="softaware_ga4_skip_merged_quote" instance="Softaware\Ga4\Observer\SkipMergedQuote"/>
    </event>
    <event name="customer_login">
        <observer name="softaware_ga4_login" instance="Softaware\Ga4\Observer\QueueLogin"/>
    </event>
    <event name="customer_register_success">
        <observer name="softaware_ga4_sign_up" instance="Softaware\Ga4\Observer\QueueSignUp"/>
    </event>
    <event name="wishlist_add_product">
        <observer name="softaware_ga4_add_to_wishlist" instance="Softaware\Ga4\Observer\QueueWishlistAdd"/>
    </event>
    <event name="sales_model_service_quote_submit_success">
        <observer name="softaware_ga4_capture_client_id" instance="Softaware\Ga4\Observer\CaptureClientId"/>
    </event>
</config>
