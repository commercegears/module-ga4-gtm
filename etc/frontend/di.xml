<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Magento\Customer\CustomerData\SectionPoolInterface">
        <arguments>
            <argument name="sectionSourceMap" xsi:type="array">
                <item name="commercegears-ga4" xsi:type="string">CommerceGears\Ga4\CustomerData\Events</item>
            </argument>
        </arguments>
    </type>

    <virtualType name="CommerceGears\Ga4\Model\Event\Provider\ViewCart" type="CommerceGears\Ga4\Model\Event\Provider\QuoteEvent">
        <arguments>
            <argument name="event" xsi:type="string">view_cart</argument>
        </arguments>
    </virtualType>
    <virtualType name="CommerceGears\Ga4\Model\Event\Provider\BeginCheckout" type="CommerceGears\Ga4\Model\Event\Provider\QuoteEvent">
        <arguments>
            <argument name="event" xsi:type="string">begin_checkout</argument>
        </arguments>
    </virtualType>

    <type name="Magento\Catalog\Block\Product\ListProduct">
        <plugin name="commercegears_ga4_register_list" type="CommerceGears\Ga4\Plugin\RegisterProductListPlugin"/>
    </type>
    <type name="Magento\Catalog\Block\Product\ProductList\Related">
        <plugin name="commercegears_ga4_register_related" type="CommerceGears\Ga4\Plugin\RegisterLinkedProductsPlugin"/>
    </type>
    <type name="Magento\Catalog\Block\Product\ProductList\Upsell">
        <plugin name="commercegears_ga4_register_upsell" type="CommerceGears\Ga4\Plugin\RegisterUpsellPlugin"/>
    </type>
    <type name="Magento\Checkout\Block\Cart\Crosssell">
        <plugin name="commercegears_ga4_register_crosssell" type="CommerceGears\Ga4\Plugin\RegisterCrosssellPlugin"/>
    </type>

    <!-- generate_lead after a successful submit (types that do not exist when Magento_Contact/Newsletter is removed are ignored) -->
    <type name="Magento\Contact\Model\MailInterface">
        <plugin name="commercegears_ga4_contact_lead" type="CommerceGears\Ga4\Plugin\ContactLeadPlugin"/>
    </type>
    <type name="Magento\Newsletter\Model\SubscriptionManagerInterface">
        <plugin name="commercegears_ga4_newsletter_lead" type="CommerceGears\Ga4\Plugin\NewsletterLeadPlugin"/>
    </type>

    <virtualType name="CommerceGears\Ga4\Model\Event\Provider\HyvaCrosssell" type="CommerceGears\Ga4\Model\Event\Provider\HyvaLinkedProducts">
        <arguments>
            <argument name="context" xsi:type="string">cart</argument>
        </arguments>
    </virtualType>
</config>
