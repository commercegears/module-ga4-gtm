<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
    <default>
        <softaware_ga4>
            <general>
                <enabled>0</enabled>
                <mode>gtm</mode>
                <gtm_url>https://www.googletagmanager.com</gtm_url>
                <load_after_consent></load_after_consent>
                <consent_default>none</consent_default>
                <debug>0</debug>
            </general>
            <data>
                <item_id>sku</item_id>
                <brand_attribute>manufacturer</brand_attribute>
                <category_path>deepest</category_path>
                <currency>display</currency>
                <price_incl_tax>0</price_incl_tax>
                <value_incl_tax>1</value_incl_tax>
                <value_incl_shipping>1</value_incl_shipping>
                <max_list_items>50</max_list_items>
                <user_data>0</user_data>
            </data>
            <measurement_protocol>
                <refund_enabled>0</refund_enabled>
                <api_secret backend_model="Magento\Config\Model\Config\Backend\Encrypted"/>
            </measurement_protocol>
        </softaware_ga4>
    </default>
</config>
