<?xml version="1.0"?>
<csp_whitelist xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Csp:etc/csp_whitelist.xsd">
    <policies>
        <policy id="script-src">
            <values>
                <value id="sw_ga4_gtm" type="host">*.googletagmanager.com</value>
                <value id="sw_ga4_ga" type="host">*.google-analytics.com</value>
                <value id="sw_ga4_analytics" type="host">*.analytics.google.com</value>
            </values>
        </policy>
        <policy id="connect-src">
            <values>
                <value id="sw_ga4_gtm" type="host">*.googletagmanager.com</value>
                <value id="sw_ga4_ga" type="host">*.google-analytics.com</value>
                <value id="sw_ga4_analytics" type="host">*.analytics.google.com</value>
                <value id="sw_ga4_doubleclick" type="host">*.g.doubleclick.net</value>
            </values>
        </policy>
        <policy id="img-src">
            <values>
                <value id="sw_ga4_gtm" type="host">*.googletagmanager.com</value>
                <value id="sw_ga4_ga" type="host">*.google-analytics.com</value>
                <value id="sw_ga4_analytics" type="host">*.analytics.google.com</value>
                <value id="sw_ga4_doubleclick" type="host">*.g.doubleclick.net</value>
            </values>
        </policy>
        <policy id="frame-src">
            <values>
                <value id="sw_ga4_gtm" type="host">*.googletagmanager.com</value>
            </values>
        </policy>
    </policies>
</csp_whitelist>
